# Normalise line endings in the repo; checkouts use the platform default
* text=auto eol=lf

# Source and config are text
*.ts   text
*.tsx  text
*.css  text
*.json text
*.md   text
*.html text
*.svg  text

# Binary assets (photos and fonts added later)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.pdf   binary

# Lockfile: keep it out of diffs and language stats, never hand-merge
package-lock.json -diff -merge linguist-generated=true
